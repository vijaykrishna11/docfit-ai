# Copy this file to .env.local and adjust values as needed.
# .env.local is gitignored and must never be committed.

# Optional. If unset: `npm run dev` defaults to http://localhost:8080 (the local backend dev
# server); a production build (`npm run build`) defaults to the page's own origin
# (window.location.origin) -- correct for a same-origin Render deployment where Spring Boot
# serves both the API and the built SPA. Only set this explicitly if the frontend and backend are
# ever deployed on two different hosts.
VITE_API_BASE_URL=http://localhost:8080
